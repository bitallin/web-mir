{
  "name": "web-legend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=11.7.0 <12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:up": "docker compose -f infra/docker/compose.yml up -d postgres",
    "db:down": "docker compose -f infra/docker/compose.yml down",
    "db:logs": "docker compose -f infra/docker/compose.yml logs -f postgres",
    "db:generate": "pnpm --filter @web-legend/persistence db:generate",
    "db:migrate": "pnpm --filter @web-legend/persistence db:migrate",
    "db:seed": "pnpm --filter @web-legend/persistence db:seed && pnpm --filter @web-legend/control-api seed:admin",
    "maps:compile": "tsx packages/map-runtime/src/compileMaps.ts",
    "assets:generate": "tsx content/assets/generateCharacters.ts",
    "repair:maps": "pnpm --filter @web-legend/control-api repair:maps",
    "load:world": "pnpm --filter @web-legend/game-server load:world",
    "load:scenario": "pnpm --filter @web-legend/game-server load:scenario",
    "load:regression": "pnpm --filter @web-legend/game-server load:regression",
    "drill:recovery": "pnpm --filter @web-legend/game-server drill:recovery",
    "drill:outbox": "tsx infra/scripts/outbox-drill.ts",
    "verify:invariants": "bash infra/scripts/database-invariants.sh",
    "db:backup": "bash infra/scripts/db-backup.sh",
    "db:restore-drill": "bash infra/scripts/db-restore-drill.sh",
    "cert:dev": "bash infra/scripts/generate-cert.sh",
    "prod:deploy": "bash infra/scripts/deploy.sh",
    "prod:rollback": "bash infra/scripts/rollback.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
