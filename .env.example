# Copy to .env for local development. Never commit .env.
NODE_ENV=development
LOG_LEVEL=debug

# This development host is itself a container that maps 8580-8589 on the host
# to 80-89 inside the container. If your environment exposes normal ports,
# these can be changed back to 5173/5174/3000/2567.
GAME_WEB_PORT=84
ADMIN_WEB_PORT=85
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=86

GAME_SERVER_HOST=0.0.0.0
GAME_SERVER_PORT=87

# Control API and Game Server share this secret for the internal admin
# command/status endpoints. Development builds default to a known value; a
# production deployment must set its own token (the env schema rejects the
# development default when NODE_ENV=production).
# INTERNAL_ADMIN_TOKEN=replace-with-a-long-random-value

# Local development administrator created by `pnpm db:seed`.
# Production requires ADMIN_SEED_PASSWORD to be set explicitly.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=web-legend-admin

# Browser origins allowed to call the Control API directly.
# Browsers normally use the Vite dev proxy, so this is only for direct calls.
CORS_ORIGINS=http://localhost:8584,http://localhost:8585

# Matches infra/docker/compose.yml. The database is disposable in local/dev.
# This SSH host is itself a container and Docker runs outside it, so the
# published port is reached through the container gateway, not 127.0.0.1.
# On a normal workstation use 127.0.0.1 instead of the gateway address.
DATABASE_URL=postgres://web_legend:web_legend_dev@192.51.0.1:5432/web_legend

# The browser reaches the realtime server through the same origin at /ws
# (Vite proxies it in development; production routes it at the reverse proxy).
# A production build may override the endpoint with VITE_GAME_SERVER_URL.

# This host cannot download Playwright browsers; use the preinstalled build.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/root/.cache/ms-playwright/chromium-1148/chrome-linux/chrome
