# syntax=docker/dockerfile:1
ARG NODE_IMAGE=node:26.13.1-bookworm-slim
ARG NGINX_IMAGE=nginx:1.27-alpine

FROM ${NODE_IMAGE} AS build
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
RUN npm install --global pnpm@11.7.0 --no-audit --no-fund
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY content ./content
COPY apps/admin-web ./apps/admin-web
RUN pnpm install --frozen-lockfile --filter @web-legend/admin-web... --filter .
RUN pnpm --filter @web-legend/admin-web build

FROM ${NGINX_IMAGE} AS runtime
COPY infra/docker/nginx/static-admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/admin-web/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
