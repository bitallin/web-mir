    "dev:watch": "tsx watch src/index.ts",
    "load:world": "tsx scripts/worldLoad.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.28",
    "@colyseus/schema": "5.0.50",
    "@colyseus/ws-transport": "0.18.5",
    "@web-legend/auth": "workspace:*",
    "@web-legend/config": "workspace:*",
    "@web-legend/content-schema": "workspace:*",
    "@web-legend/contracts": "workspace:*",
    "@web-legend/game-application": "workspace:*",
    "@web-legend/game-domain": "workspace:*",
    "@web-legend/game-simulation": "workspace:*",
    "@web-legend/map-runtime": "workspace:*",
    "@web-legend/observability": "workspace:*",
    "@web-legend/persistence": "workspace:*",
    "express": "5.3.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.10",
    "@types/express": "5.0.6",
    "drizzle-orm": "0.45.4",
    "tsup": "9.0.0",
    "tsx": "4.23.15"
  }
